# ==============================================================================
# Environment Configuration (.env)
# ==============================================================================
# HINWEIS: Dieser API-Schlüssel wird AUSSCHLIESSLICH benötigt, wenn Sie die OCR-
# Pipeline (scripts/mistral_ocr.py bzw. scripts/batch_ocr_runner.py) erneut
# gegen die Mistral AI API ausführen möchten.
#
# Für die übrigen Schritte (Alignment, TEI-P5-XML-Generierung, RelaxNG-Validierung,
# Sandwich-PDF-Assemblierung und Datenanalyse) wird KEIN API-Schlüssel benötigt,
# da alle 478 OCR-JSON-Dateien vollständig im Repository unter data/mistral/
# vorliegen.
# ==============================================================================

MISTRAL_API_KEY=your_mistral_api_key_here
